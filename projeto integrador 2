  <!-- ============ JAVASCRIPT ============ -->
  <script>
    /* ===== ACESSIBILIDADE ===== */
    const btnContraste = document.getElementById('btnContraste');
    const btnDislexia = document.getElementById('btnDislexia');
    const btnFonte = document.getElementById('btnFonte');

    btnContraste.addEventListener('click', () => {
      document.body.classList.toggle('alto-contraste');
      const ativo = document.body.classList.contains('alto-contraste');
      btnContraste.setAttribute('aria-pressed', ativo);
    });
    btnDislexia.addEventListener('click', () => {
      document.body.classList.toggle('dislexia');
      const ativo = document.body.classList.contains('dislexia');
      btnDislexia.setAttribute('aria-pressed', ativo);
    });
    btnFonte.addEventListener('click', () => {
      document.body.classList.toggle('fonte-grande');
      const ativo = document.body.classList.contains('fonte-grande');
      btnFonte.setAttribute('aria-pressed', ativo);
    });

    /* ===== ESPECTRO INTERATIVO ===== */
    const espectroBarra = document.getElementById('espectroBarra');
    const espectroInfo = document.getElementById('espectroInfo');

    const faixas = [
      { nome: 'Ultravioleta C (UVC)', min: 0, max: 8, cor: '#4B0082',
        desc: 'Comprimento 100–280 nm. Totalmente absorvido pela camada de ozônio — não chega à piscina.' },
      { nome: 'Ultravioleta B (UVB)', min: 8, max: 14, cor: '#6A0DAD',
        desc: 'Comprimento 280–315 nm. Parcialmente filtrado pela atmosfera. Degrada o cloro da piscina.' },
      { nome: 'Ultravioleta A (UVA)', min: 14, max: 22, cor: '#8A2BE2',
        desc: 'Comprimento 315–400 nm. Atinge a superfície. Contribui para o desbotamento de materiais.' },
      { nome: 'Violeta', min: 22, max: 28, cor: '#8B00FF',
        desc: 'Comprimento 400–450 nm. Início da luz visível. Penetra alguns cm na água.' },
      { nome: 'Azul', min: 28, max: 35, cor: '#0066FF',
        desc: 'Comprimento 450–495 nm. Espalhado pela água — por isso a piscina parece azul!' },
      { nome: 'Verde', min: 35, max: 45, cor: '#00CC44',
        desc: 'Comprimento 495–570 nm. Penetra mais profundamente na água que outras cores.' },
      { nome: 'Amarelo', min: 45, max: 52, cor: '#FFCC00',
        desc: 'Comprimento 570–590 nm. Absorvido gradualmente pela água e convertido em calor.' },
      { nome: 'Laranja', min: 52, max: 60, cor: '#FF8800',
        desc: 'Comprimento 590–620 nm. Boa penetração e contribuição para o aquecimento.' },
      { nome: 'Vermelho', min: 60, max: 70, cor: '#FF0000',
        desc: 'Comprimento 620–700 nm. Fim do visível. Absorvido pela água nas camadas superiores.' },
      { nome: 'Infravermelho Próximo (IV-P)', min: 70, max: 82, cor: '#AA0000',
        desc: 'Comprimento 700–1400 nm. Penetra alguns milímetros na água e aquece diretamente.' },
      { nome: 'Infravermelho Médio (IV-M)', min: 82, max: 92, cor: '#660000',
        desc: 'Comprimento 1400–3000 nm. Fortemente absorvido pela água — principal responsável pelo aquecimento!' },
      { nome: 'Infravermelho Longo (IV-L)', min: 92, max: 100, cor: '#330000',
        desc: 'Comprimento > 3000 nm. Absorvido na superfície. A água também emite nessa faixa ao esfriar.' }
    ];

    function atualizarEspectro(xPercent) {
      const faixa = faixas.find(f => xPercent >= f.min && xPercent < f.max) || faixas[faixas.length-1];
      espectroInfo.innerHTML = `
        <h4 style="color: ${faixa.cor};">${faixa.nome}</h4>
        <p>${faixa.desc}</p>
      `;
    }

    espectroBarra.addEventListener('mousemove', (e) => {
      const rect = espectroBarra.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      atualizarEspectro(x);
    });
    espectroBarra.addEventListener('click', (e) => {
      const rect = espectroBarra.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      atualizarEspectro(x);
    });
    // Navegação por teclado no espectro
    let posEspectro = 50;
    espectroBarra.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { posEspectro = Math.min(99, posEspectro + 2); atualizarEspectro(posEspectro); e.preventDefault(); }
      if (e.key === 'ArrowLeft') { posEspectro = Math.max(0, posEspectro - 2); atualizarEspectro(posEspectro); e.preventDefault(); }
    });

    /* ===== SIMULADOR DA PISCINA ===== */
    const canvas = document.getElementById('canvasPiscina');
    const ctx = canvas.getContext('2d');

    const hora = document.getElementById('hora');
    const irradiancia = document.getElementById('irradiancia');
    const corCapa = document.getElementById('corCapa');
    const volume = document.getElementById('volume');

    const horaValor = document.getElementById('horaValor');
    const irradianciaValor = document.getElementById('irradianciaValor');
    const corCapaValor = document.getElementById('corCapaValor');
    const volumeValor = document.getElementById('volumeValor');
    const tempFinal = document.getElementById('tempFinal');
    const explicacaoSim = document.getElementById('explicacaoSim');

    function desenharPiscina() {
      const w = canvas.width, h = canvas.height;
      const hVal = parseFloat(hora.value);
      const iVal = parseFloat(irradiancia.value);
      const cVal = parseFloat(corCapa.value);
      const vVal = parseFloat(volume.value);

      // Céu (muda com a hora)
      const fatorDia = Math.sin(((hVal - 6) / 12) * Math.PI);
      const rCeu = Math.floor(135 + 120 * (1 - fatorDia));
      const gCeu = Math.floor(206 * fatorDia + 100 * (1 - fatorDia));
      const bCeu = Math.floor(235 * fatorDia + 50 * (1 - fatorDia));
      const gradCeu = ctx.createLinearGradient(0, 0, 0, h * 0.5);
      gradCeu.addColorStop(0, `rgb(${rCeu},${gCeu},${bCeu})`);
      gradCeu.addColorStop(1, `rgb(${Math.floor(rCeu*0.7)},${Math.floor(gCeu*0.8)},${Math.floor(bCeu*0.9)})`);
      ctx.fillStyle = gradCeu;
      ctx.fillRect(0, 0, w, h * 0.5);

      // Sol
      const anguloSol = ((hVal - 6) / 12) * Math.PI;
      const solX = w * (hVal - 6) / 12;
      const solY = h * 0.5 - Math.sin(anguloSol) * h * 0.4;
      const brilhoSol = Math.floor(80 + 175 * fatorDia);

      // Raios solares
      ctx.strokeStyle = `rgba(255, 200, 0, ${0.3 * fatorDia})`;
      ctx.lineWidth = 2;
      for (let i = 0; i < 8; i++) {
        const ang = (i / 8) * Math.PI * 2;
        ctx.beginPath();
        ctx.moveTo(solX + Math.cos(ang) * 35, solY + Math.sin(ang) * 35);
        ctx.lineTo(solX + Math.cos(ang) * 55, solY + Math.sin(ang) * 55);
        ctx.stroke();
      }

      // Sol (corpo)
      const gradSol = ctx.createRadialGradient(solX, solY, 5, solX, solY, 35);
      gradSol.addColorStop(0, `rgb(255, 255, ${brilhoSol})`);
      gradSol.addColorStop(1, `rgb(255, ${Math.floor(150*fatorDia+50)}, 0)`);
      ctx.fillStyle = gradSol;
      ctx.beginPath();
      ctx.arc(solX, solY, 30, 0, Math.PI * 2);
      ctx.fill();

      // Raios indo até a piscina
      ctx.strokeStyle = `rgba(255, 200, 0, ${0.4 * fatorDia * (iVal/1000)})`;
      ctx.lineWidth = 1.5;
      for (let i = 0; i < 12; i++) {
        const xAlvo = 100 + i * 45;
        ctx.beginPath();
        ctx.moveTo(solX, solY);
        ctx.lineTo(xAlvo, h * 0.55);
        ctx.stroke();
      }

      // Piscina
      const gradAgua = ctx.createLinearGradient(0, h * 0.55, 0, h);
      // Cor da água fica mais quente conforme absorção
      const absorcao = cVal / 100;
      const tempAquecimento = (iVal / 1000) * absorcao * fatorDia * (30 / vVal) * 6;
      const rAgua = Math.floor(50 + tempAquecimento * 8);
      const gAgua = Math.floor(150 + tempAquecimento * 3);
      const bAgua = Math.floor(220 - tempAquecimento * 5);
      gradAgua.addColorStop(0, `rgb(${rAgua},${gAgua},${bAgua})`);
      gradAgua.addColorStop(1, `rgb(${Math.floor(rAgua*0.5)},${Math.floor(gAgua*0.6)},${Math.floor(bAgua*0.8)})`);
      ctx.fillStyle = gradAgua;
      ctx.fillRect(50, h * 0.55, w - 100, h * 0.4);

      // Bordas da piscina
      ctx.strokeStyle = '#DDD';
      ctx.lineWidth = 6;
      ctx.strokeRect(50, h * 0.55, w - 100, h * 0.4);

      // Ondas
      ctx.strokeStyle = 'rgba(255,255,255,0.4)';
      ctx.lineWidth = 2;
      for (let i = 0; i < 3; i++) {
        ctx.beginPath();
        for (let x = 60; x < w - 60; x += 5) {
          const y = h * 0.58 + i * 20 + Math.sin((x + Date.now()/500 + i * 30) / 20) * 3;
          if (x === 60) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.stroke();
      }

      // Indicador de temperatura na água
      ctx.fillStyle = 'rgba(255,255,255,0.9)';
      ctx.fillRect(w - 180, h * 0.7, 120, 50);
      ctx.strokeStyle = '#023E8A';
      ctx.lineWidth = 2;
      ctx.strokeRect(w - 180, h * 0.7, 120, 50);
      ctx.fillStyle = '#023E8A';
      ctx.font = 'bold 14px Inter, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('🌡️ Temperatura', w - 120, h * 0.7 + 20);
      ctx.font = 'bold 20px Inter, sans-serif';
      ctx.fillStyle = '#FB8500';
      ctx.fillText((22 + tempAquecimento).toFixed(1) + ' °C', w - 120, h * 0.7 + 42);

      // Atualiza valores
      horaValor.textContent = `${Math.floor(hVal)}:${(hVal % 1) * 60 === 0 ? '00' : '30'}`;
      irradianciaValor.textContent = `${iVal} W/m²`;
      if (cVal < 30) corCapaValor.textContent = 'Clara (baixa absorção)';
      else if (cVal < 70) corCapaValor.textContent = 'Média absorção';
      else corCapaValor.textContent = 'Escura (alta absorção)';
      volumeValor.textContent = `${vVal} m³`;

      // Temperatura final
      const tempCalc = 22 + tempAquecimento;
      tempFinal.textContent = `${tempCalc.toFixed(1)} °C`;

      if (tempCalc < 25) {
        explicacaoSim.textContent = '🌡️ Temperatura amena. A piscina perde mais calor do que absorve — considere usar uma capa térmica escura.';
      } else if (tempCalc < 30) {
        explicacaoSim.textContent = '☀️ Temperatura agradável! Condições ideais de irradiância e absorção.';
      } else {
        explicacaoSim.textContent = '🔥 Temperatura elevada! A alta absorção e irradiância estão aquecendo bastante a água.';
      }
    }

    [hora, irradiancia, corCapa, volume].forEach(el => {
      el.addEventListener('input', () => {
        hora.setAttribute('aria-valuenow', hora.value);
        desenharPiscina();
      });
    });

    // Animação das ondas
    function animar() {
      desenharPiscina();
      requestAnimationFrame(animar);
    }
    animar();

    // Redimensionar canvas responsivo
    function redimensionarCanvas() {
      const wrap = canvas.parentElement;
      const maxW = wrap.clientWidth - 32;
      if (maxW < 700) {
        canvas.style.width = '100%';
        canvas.style.height = 'auto';
      }
    }
    window.addEventListener('resize', redimensionarCanvas);
    redimensionarCanvas();

    /* ===== ANIMAÇÃO DAS BARRAS DE ABSORÇÃO AO SCROLL ===== */
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const barras = entry.target.querySelectorAll('.barra-preenchimento');
          barras.forEach(b => {
            const w = b.style.width;
            b.style.width = '0';
            setTimeout(() => { b.style.width = w; }, 100);
          });
        }
      });
    }, { threshold: 0.3 });
    const compSection = document.getElementById('comparativo');
    if (compSection) observer.observe(compSection);
  </script>
